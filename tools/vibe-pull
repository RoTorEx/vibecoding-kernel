#!/usr/bin/env python3
from __future__ import annotations

import argparse
import fcntl
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path, PurePosixPath


ROUTING_START = "<!-- VIBE:KERNEL_ROUTING_START -->"
ROUTING_END = "<!-- VIBE:KERNEL_ROUTING_END -->"
MAKE_START = "# VIBE:KERNEL_MAKE_START"
MAKE_END = "# VIBE:KERNEL_MAKE_END"
REQUIRED_RUNTIME_FILES = {"OPERATING.md", "RELEASE.md", "EVOLUTION.md"}
ROUTING_TEMPLATE = "templates/kernel-routing.md"
MAKE_TEMPLATE = "templates/kernel-make.mk"
SKELETON = "templates/project-skeleton"
REQUIRED_SKELETON_FILES = {".gitignore", "AGENTS.md", "BUSINESS.md", "CHANGELOG.md", "Makefile", "README.md"}


def fail(message: str) -> int:
    print(f"ERROR: {message}", file=sys.stderr)
    return 1


def git(root: Path, *arguments: str) -> bytes:
    result = subprocess.run(["git", "-C", str(root), *arguments], capture_output=True)
    if result.returncode:
        detail = result.stderr.decode("utf-8", "replace").strip()
        raise ValueError(detail or f"git {arguments[0]} failed in {root}")
    return result.stdout


def release_files(root: Path, *, bootstrap: bool) -> dict[str, tuple[bytes, bool]]:
    # The checkout selects a release. Only its tag supplies installed content.
    version = git(root, "show", "HEAD:VERSION").decode("utf-8").strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+", version):
        raise ValueError(f"invalid committed Kernel version: {version!r}")
    tag = f"refs/tags/v{version}"
    try:
        revision = git(root, "rev-parse", "--verify", f"{tag}^{{commit}}").decode("ascii").strip()
    except ValueError as exc:
        raise ValueError(f"local Kernel release v{version} is missing. Update the Kernel source and its tags.") from exc

    paths = ["VERSION", "core", ROUTING_TEMPLATE, MAKE_TEMPLATE]
    required = {"VERSION", ROUTING_TEMPLATE, MAKE_TEMPLATE, *(f"core/{name}" for name in REQUIRED_RUNTIME_FILES)}
    if bootstrap:
        paths.append(SKELETON)
        required.update(f"{SKELETON}/{name}" for name in REQUIRED_SKELETON_FILES)
    entries = git(root, "ls-tree", "-rz", "--full-tree", revision, "--", *paths)
    files = {}
    for entry in entries.rstrip(b"\0").split(b"\0"):
        if not entry:
            continue
        info, path_name = entry.split(b"\t", 1)
        name = path_name.decode("utf-8")
        path = PurePosixPath(name)
        if name.startswith("core/") and (path.parent != PurePosixPath("core") or path.suffix != ".md"):
            continue
        mode, kind, blob = info.split()
        if kind != b"blob" or mode not in (b"100644", b"100755"):
            raise ValueError(f"expected a regular release file at {name} in v{version}")
        files[name] = git(root, "cat-file", "blob", blob.decode("ascii")), mode == b"100755"
    missing = sorted(required - files.keys())
    if missing:
        raise ValueError(f"Kernel release v{version} is incomplete: {', '.join(missing)}")
    if files["VERSION"][0].decode("utf-8").strip() != version:
        raise ValueError(f"Kernel tag v{version} does not match its VERSION file")
    return files


def initialize_project(root: Path) -> None:
    if root.exists() and (not root.is_dir() or any(path.name != ".git" for path in root.iterdir())):
        raise ValueError(f"target must be empty except for .git: {root}")
    git_dir = root / ".git"
    if git_dir.exists() or git_dir.is_symlink():
        worktree = Path(git(root, "rev-parse", "--show-toplevel").decode("utf-8").strip()).resolve()
        if worktree != root:
            raise ValueError(f"target must have its own Git worktree: {root}")
        git(root, "symbolic-ref", "HEAD")
        if git(root, "for-each-ref", "--count=1"):
            raise ValueError(f"target Git repository already has refs: {root}")
        if git(root, "ls-files", "-z"):
            raise ValueError(f"target Git index must be empty: {root}")
    else:
        git(root, "init", "-q", "-b", "main")
    git(root, "var", "GIT_AUTHOR_IDENT")
    git(root, "var", "GIT_COMMITTER_IDENT")
    git(root, "symbolic-ref", "HEAD", "refs/heads/main")


def atomic_write(path: Path, content: str) -> bool:
    data = content.encode("utf-8")
    if path.exists() and path.read_bytes() == data:
        return False

    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as handle:
        handle.write(data)
        temporary = Path(handle.name)

    os.replace(temporary, path)
    return True


def render_agents(existing: str, routing: str) -> str:
    if existing.count(ROUTING_START) != 1 or existing.count(ROUTING_END) != 1:
        raise ValueError("AGENTS.md must contain exactly one managed kernel-routing block")

    start = existing.index(ROUTING_START) + len(ROUTING_START)
    end = existing.index(ROUTING_END)
    if end < start:
        raise ValueError("AGENTS.md kernel-routing markers are out of order")

    replacement = f"\n\n{routing.strip()}\n\n"
    return existing[:start] + replacement + existing[end:]


def render_makefile(existing: str, managed_targets: str) -> str:
    start_count = existing.count(MAKE_START)
    end_count = existing.count(MAKE_END)
    block = f"{MAKE_START}\n\n{managed_targets.strip()}\n\n{MAKE_END}\n"

    if start_count == 0 and end_count == 0:
        if not existing:
            return block
        separator = "" if existing.endswith("\n\n") else "\n" if existing.endswith("\n") else "\n\n"
        return existing + separator + block
    if start_count != 1 or end_count != 1:
        raise ValueError("Makefile must contain zero or one managed kernel-command block")

    start = existing.index(MAKE_START)
    end = existing.index(MAKE_END) + len(MAKE_END)
    if end < start:
        raise ValueError("Makefile kernel-command markers are out of order")
    if existing.startswith("\r\n", end):
        end += 2
    elif existing.startswith("\n", end):
        end += 1
    return existing[:start] + block + existing[end:]


def prune_runtime(runtime_dir: Path, allowed: set[str]) -> list[str]:
    removed: list[str] = []
    if not runtime_dir.exists():
        return removed
    if runtime_dir.is_symlink() or not runtime_dir.is_dir():
        raise ValueError(f"managed runtime path is not a normal directory: {runtime_dir}")

    for path in sorted(runtime_dir.iterdir(), key=lambda item: item.name):
        if path.name in allowed and path.is_file() and not path.is_symlink():
            continue
        removed.append(path.name)
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
    return removed


def install(root: Path, kernel_root: Path, files: dict[str, tuple[bytes, bool]], project_name: str | None) -> int:
    bootstrap = project_name is not None
    agents_path = root / "AGENTS.md"
    makefile_path = root / "Makefile"
    runtime_dir = root / ".vibe" / "kernel"
    if not bootstrap:
        for path in (agents_path, makefile_path):
            if not path.is_file():
                raise ValueError(f"child project is missing {path.name}: {root}")

    skeleton = {key.removeprefix(f"{SKELETON}/"): entry for key, entry in files.items()
                if key.startswith(f"{SKELETON}/")}
    runtime = {PurePosixPath(key).name: data.decode("utf-8") for key, (data, _) in files.items()
               if key.startswith("core/")}
    original_agents = skeleton["AGENTS.md"][0] if bootstrap else agents_path.read_bytes()
    original_make = skeleton["Makefile"][0] if bootstrap else makefile_path.read_bytes()
    updated_agents = render_agents(
        original_agents.decode("utf-8"), files[ROUTING_TEMPLATE][0].decode("utf-8"),
    )
    updated_makefile = render_makefile(
        original_make.decode("utf-8"), files[MAKE_TEMPLATE][0].decode("utf-8"),
    )
    version_path = runtime_dir / "VERSION"
    version_content = files["VERSION"][0].decode("utf-8")

    if bootstrap:
        readme, executable = skeleton["README.md"]
        skeleton["README.md"] = (
            readme.decode("utf-8").replace("TODO_PROJECT_NAME", project_name, 1).encode("utf-8"), executable,
        )
        initialize_project(root)
        for name, (data, executable) in skeleton.items():
            target = root / name
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            if executable:
                target.chmod(target.stat().st_mode | 0o111)
        atomic_write(root / ".vibe" / "KERNEL_SOURCE", f"{kernel_root}\n")

    removed = prune_runtime(runtime_dir, {*runtime, "VERSION"})
    old_version = version_path.read_text(encoding="utf-8").strip() if version_path.is_file() else "none"
    updates = {runtime_dir / name: content for name, content in runtime.items()}
    updates.update({agents_path: updated_agents, makefile_path: updated_makefile})
    pending = {path: content for path, content in updates.items()
               if not path.is_file() or path.read_bytes() != content.encode("utf-8")}

    if pending:
        # A failed install must not leave a version label on a partially updated payload.
        version_path.unlink(missing_ok=True)
    changed = []
    for path, content in pending.items():
        if atomic_write(path, content):
            relative = path.relative_to(root).as_posix()
            changed.append("Makefile kernel-command block" if path == makefile_path else relative)
    if atomic_write(version_path, version_content):
        changed.append(".vibe/kernel/VERSION")
    if bootstrap:
        foundation = [*skeleton, *(f".vibe/kernel/{name}" for name in (*runtime, "VERSION"))]
        git(root, "--literal-pathspecs", "add", "--", *foundation)
        git(root, "--literal-pathspecs", "commit", "--only", "-m", "Initial commit", "--", *foundation)

    print(f"Kernel: {old_version} -> {version_content.strip()}")
    for path in changed:
        print(f"Updated: {path}")
    for name in removed:
        print(f"Removed obsolete runtime entry: .vibe/kernel/{name}")
    if not changed and not removed:
        print("Already current.")
    else:
        print("Next: read .vibe/kernel/EVOLUTION.md adoption notes and apply relevant changes before finalizing the adoption.")
    if bootstrap:
        print(f"Created {root} with Initial commit")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Install a local tagged Kernel release.")
    parser.add_argument("child_project_root", type=Path)
    parser.add_argument("--new-project", metavar="NAME", help="create and commit an empty project's foundation")
    args = parser.parse_args(argv[1:])
    kernel_root = Path(__file__).resolve().parent.parent
    child_root = args.child_project_root.resolve()
    bootstrap = args.new_project is not None

    try:
        files = release_files(kernel_root, bootstrap=bootstrap)
        if bootstrap:
            child_root.mkdir(exist_ok=True)
        elif not child_root.is_dir():
            return fail(f"child project does not exist: {child_root}")
        descriptor = os.open(child_root, os.O_RDONLY)
        try:
            # Serialize installs to this child without adding a file to its tree.
            fcntl.flock(descriptor, fcntl.LOCK_EX)
            return install(child_root, kernel_root, files, args.new_project)
        finally:
            os.close(descriptor)
    except (OSError, ValueError) as exc:
        return fail(str(exc))


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
